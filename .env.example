# Local development only. Copy to .env (make env). Never commit .env.
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=fraud
POSTGRES_PORT=5433

FRAUD_DATABASE_URL=postgresql://fraud:change-me-local-only@localhost:5433/fraud
# Integration tests use the disposable services in docker-compose.test.yml (make test-integration),
# never the application's database, Redis or Kafka; a guard refuses shared targets.
FRAUD_TEST_DATABASE_URL=postgresql://fraud:itest-only@127.0.0.1:5543/fraud_test
FRAUD_API_KEY=change-me-local-only

REDIS_PORT=6380
FRAUD_REDIS_URL=redis://localhost:6380/0
FRAUD_TEST_REDIS_URL=redis://127.0.0.1:6480/15
FRAUD_TEST_KAFKA_BOOTSTRAP=127.0.0.1:9394

KAFKA_PORT=9094
FRAUD_KAFKA_BOOTSTRAP=127.0.0.1:9094

FRAUD_MLFLOW_TRACKING_URI=http://127.0.0.1:5050
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://fraud:change-me-local-only@localhost:5433/mlflow

# Optional: run a second, isolated copy next to this one (distinct Compose project and ports).
COMPOSE_PROJECT_NAME=fraud-platform
MLFLOW_PORT=5050
FRAUD_CONSOLE_API_PORT=8110
FRAUD_CONSOLE_PORT=8200
